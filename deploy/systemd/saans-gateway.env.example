# /etc/saans/saans.env: the gateway's secrets, as environment variables.
#
# Install with mode 0600, owned by root: systemd reads it before the
# service drops to its own user, so nothing else on the machine can.
# Fill in only the variables your /etc/saans/saans.toml names; the names
# below are the ones saans.example.toml uses. The gateway refuses to start
# if a variable the config names is missing, and never prints a value.

# [[frame_key]] env: 64 hex digits from `saans-gateway --new-site-key`
# SAANS_FRAME_KEY=

# [telegram.<name>] bot_token_env: the token @BotFather gave you
# SAANS_TELEGRAM_TOKEN=

# [webhook.<name>] secret_env: the key the X-Saans-Signature HMAC uses
# SAANS_WEBHOOK_KEY=

# [mqtt] password_env (a broker on this machine only)
# SAANS_MQTT_PASSWORD=
