# saans-gateway as a system service: started at boot, restarted if it
# crashes, logs in the journal. Install and operate: deploy/README.md.
#
# The gateway holds health data (ADR-001, ADR-005), so it runs as a
# throwaway user that owns nothing but its own state directory, with
# almost every other part of the machine out of reach. Nothing here needs
# root once it is running: the ports (UDP 5566, HTTP 8080) are above 1024.

[Unit]
Description=Saans gateway (WiFi sensing: fusion, detectors, dashboard)
Documentation=https://github.com/devreddy1015/areu_there/blob/main/deploy/README.md
Wants=network-online.target
After=network-online.target time-sync.target
# A config that cannot start (a missing key variable, a bad file) fails
# fast and stays failed, rather than restarting forever.
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=exec
ExecStart=/usr/local/bin/saans-gateway --config /etc/saans/saans.toml
# Secrets, by the names saans.toml gives them (frame keys, the Telegram
# token, the webhook key, the MQTT password). Read by systemd before the
# service drops to its own user; never in saans.toml. Optional: `-`.
EnvironmentFile=-/etc/saans/saans.env

# SIGTERM is a clean stop: history, replay floors and the event log are
# written, and MQTT publishes `offline`. Its own waits add up to ~12 s.
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

# Its own user, made up at start, owning only /var/lib/saans. Point
# data_dir there (deploy/README.md); /etc/saans is readable, not writable.
DynamicUser=yes
StateDirectory=saans
StateDirectoryMode=0700
ConfigurationDirectory=saans
WorkingDirectory=/var/lib/saans
UMask=0077

# Everything else out of reach.
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

[Install]
WantedBy=multi-user.target
