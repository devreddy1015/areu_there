given_clamp_negative 0
given_set_baseline 1
n_err 13
err.0 LinkMeasurement(geometry, window_s=0.0, sample_rate_hz=10.0)
err.1 LinkMeasurement(geometry, sample_rate_hz=0.0)
err.2 LinkMeasurement(geometry, sample_rate_hz=10.0, min_samples=1)
err.3 LinkMeasurement(geometry, sample_rate_hz=10.0, calibration_mode='median')
err.4 update(0.0, 0, 0, frame)
err.5 update(0.0, 0, 7, frame)
err.6 set_baseline([0.1] * 5)
err.7 set_baseline([0.1] * 5 + [-0.1])
err.8 set_baseline([0.1] * 5 + [nan])
err.9 set_baseline([0.1] * 6, [0.1] * 5)
err.10 calibrate_from(empty stream)
err.11 CsiFrame([1.0, 2.0], [0.0], 0, 10.0)
err.12 CsiFrame([1.0], [0.0], 0, 0.0)
