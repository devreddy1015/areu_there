label SIM
spec locate_v1
reasons no_disturbance,implausible_radius,not_significant,no_reports,too_few_ranges,degenerate,not_converged,gated
n_steps 60
n_pixels 192
n_variants 2
variants a,b
b_tracker.z_threshold 4.0
b_tracker.centroid_radius_m 0.75
b_tracker.accel_psd 0.5
b_tracker.meas_noise_m 0.3
b_tracker.init_speed_std_ms 0.5
b_tracker.max_coast_s 1.0
b_tracker.clamp_to_room 0
